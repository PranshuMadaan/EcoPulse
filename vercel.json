{
  "version": 2,
  "builds": [
    {
      "src": "api/iot_telemetry.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/ai_audit.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/vfd_analytics.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/iot",   "dest": "api/iot_telemetry.py" },
    { "src": "/api/audit", "dest": "api/ai_audit.py" },
    { "src": "/api/vfd",   "dest": "api/vfd_analytics.py" },
    { "src": "/(.*)",      "dest": "public/$1" }
  ]
}
